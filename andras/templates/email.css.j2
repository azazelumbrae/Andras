body { font: 17px/1.55 system-ui, sans-serif; max-width: 620px; margin: 0 auto; padding: 28px;
       background: #10131a; color: #e8ecf3; }
.card { background: #1b2230; border-radius: 14px; padding: 28px; }
h1 { font-size: 21px; margin: 0 0 14px; }
.banner { font-size: 13px; color: #97a3b6; border-bottom: 1px solid #2c3546; padding-bottom: 12px;
          margin-bottom: 18px; }
.cta { display: inline-block; margin-top: 20px; padding: 12px 18px; border-radius: 8px;
       background: #2563eb; color: #fff; text-decoration: none; font-weight: 600; }
