Screen {
  background: #0d1117;
  color: #e6edf3;
  padding: 1 2;
  overflow-y: auto;
}

Header {
  background: #161b22;
  color: #8bd5ff;
}

Footer {
  background: #161b22;
  color: #8b949e;
}

.step {
  text-style: bold;
  color: #8bd5ff;
  padding: 1 0;
}

.hint {
  color: #8b949e;
  padding-bottom: 1;
}

.label {
  color: #d2a8ff;
  padding-top: 1;
}

.blocked {
  color: #ff7b72;
  text-style: bold;
  padding: 1 0;
}

Input, TextArea, Select {
  background: #161b22;
  border: tall #30363d;
  color: #e6edf3;
}

Input:focus, TextArea:focus {
  border: tall #58a6ff;
}

ListView {
  background: #0d1117;
  border: tall #30363d;
  height: auto;
  max-height: 60vh;
}

ListItem {
  padding: 1 2;
}

ListItem.--highlight {
  background: #1f6feb;
  color: #ffffff;
}

#summary {
  background: #161b22;
  border: tall #30363d;
  padding: 1 2;
}

RichLog {
  background: #0b0e14;
  border: tall #30363d;
  height: 1fr;
  min-height: 12;
}

TextArea {
  height: 5;
}

Button.option {
  margin: 0 1 1 0;
}

.dialog {
  background: #161b22;
  border: thick #58a6ff;
  padding: 1 2;
  width: 90%;
  height: auto;
  align: center middle;
}

#options {
  height: auto;
  max-height: 40vh;
}

