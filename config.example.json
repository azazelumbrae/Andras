{
  "smtp_host": "smtp.example.com",
  "smtp_port": 587,
  "smtp_security": "starttls",
  "smtp_user_env": "ANDRAS_SMTP_USER",
  "smtp_password_env": "ANDRAS_SMTP_PASSWORD",
  "from_address": "tu-direccion-de-envio@example.com",
  "from_name": "ANDRAS Lab",
  "authorized_recipients": [
    "andras-lab@mailinator.com"
  ],
  "bind_host": "127.0.0.1",
  "port": 8765,
  "base_url": "http://127.0.0.1:8765",
  "database": "data/andras.sqlite3",
  "capture_credentials": true,
  "osint_toolkit": "",
  "recon_delay": 1.5,
  "recon_budget_seconds": 420,
  "recon_max_pages": 8,
  "llm": {
    "provider": "deepseek",
    "timeout": 180,
    "providers": {
      "deepseek": {
        "api_key_env": "ANDRAS_DEEPSEEK_API_KEY",
        "model": "deepseek-chat"
      },
      "ollama": {
        "base_url": "http://127.0.0.1:11434/v1",
        "model": "gpt-oss:120b-cloud",
        "needs_key": false
      }
    },
    "phase_models": {
      "plan": {
        "provider": "deepseek"
      },
      "dossier": {
        "provider": "deepseek"
      },
      "campaign": {
        "provider": "deepseek"
      }
    }
  },
  "smtp_auth": true,
  "from_domain": "",
  "imap_host": "",
  "imap_port": 993,
  "imap_user_env": "ANDRAS_IMAP_USER",
  "imap_password_env": "ANDRAS_IMAP_PASSWORD",
  "imap_folder": "INBOX",
  "telegram_token": "",
  "telegram_chat_id": "",
  "twilio_sid": "",
  "twilio_token": "",
  "twilio_from": "",
  "whatsapp_from": "",
  "hook_secret": "",
  "agent": {
    "mode": "asistido",
    "max_steps": 40,
    "spend_threshold_usd": 0.25
  },
  "notify": {
    "channels": ["desktop"],
    "levels": ["hit", "critical"]
  },
  "net": {
    "default_profile": "direct",
    "tor_socks": "socks5://127.0.0.1:9050",
    "doh_url": "",
    "jitter_ms": 0
  },
  "wallet": {
    "network": "testnet",
    "monero_rpc": "http://127.0.0.1:18082/json_rpc"
  }
}
