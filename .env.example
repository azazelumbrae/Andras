# Variables de entorno de ANDRAS. Copia a `.env` y no lo subas.
# config.json sólo guarda los nombres de variable, nunca los secretos.

# Modelo (DeepSeek; cualquier proveedor compatible con OpenAI vale)
DEEPSEEK_API_KEY=

# Correo del atacante
ANDRAS_SMTP_USER=
ANDRAS_SMTP_PASSWORD=

# Respuestas: sin esto no se detecta `replied`
ANDRAS_IMAP_USER=
ANDRAS_IMAP_PASSWORD=

# Avatares y respuestas de Telegram
ANDRAS_TELEGRAM_TOKEN=

# SMS y WhatsApp
ANDRAS_TWILIO_SID=
ANDRAS_TWILIO_TOKEN=

# Conveniencias
ANDRAS_YES=1        # no pedir confirmación en comandos que ya la piden
